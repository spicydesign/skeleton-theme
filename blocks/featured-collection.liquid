{% doc %}
  Renders a featured collection as a grid of product cards with a
  heading and a link to the full collection. The collection comes from
  the block's settings; when unset, the first collection that contains
  products is used so the block always renders something meaningful.

  @example
  {% block 'featured-collection' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign featured = block.settings.collection
  if featured == blank
    for candidate in collections
      if candidate.products.size > 0
        assign featured = candidate
        break
      endif
    endfor
  endif

  assign heading = block.settings.heading | default: featured.title
-%}

{% if featured != blank %}
  <div class="featured-collection" {{ block.shopify_attributes }}>
    <h2>{{ heading | escape }}</h2>

    <div class="featured-collection__grid">
      {% for product in featured.products limit: block.settings.product_limit %}
        <article class="featured-collection__card">
          {% if product.featured_image %}
            {% render 'image',
              class: 'featured-collection__image',
              image: product.featured_image,
              url: product.url,
              width: 400,
              height: 400,
              crop: 'center'
            %}
          {% endif %}

          <h3 class="featured-collection__title">
            {{ product.title | escape | link_to: product.url }}
          </h3>
          <p class="featured-collection__price">{{ product.price | money }}</p>
        </article>
      {% endfor %}
    </div>

    <p>
      <a href="{{ featured.url }}" role="button">
        {{ 'featured_collection.view_all' | t }}
      </a>
    </p>
  </div>
{% endif %}

{% stylesheet %}
  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: var(--pico-spacing, 1rem);
  }

  .featured-collection__card {
    min-width: 0;
  }

  .featured-collection__title {
    font-size: 1rem;
    margin-block-end: 0.25rem;
  }

  .featured-collection__price {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}
